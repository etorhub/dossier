# Optional for development: docker-compose up works without this file.
# Copy to .env to override defaults or for production.

# Database (dev defaults used when .env is absent)
POSTGRES_PASSWORD=devpassword
POSTGRES_USER=dossier
POSTGRES_DB=dossier

# Flask (dev default used when .env is absent)
SECRET_KEY=dev-secret-key-change-in-production

# Image tag the NAS / Portainer stack pulls from GHCR (published by
# .github/workflows/publish.yml). Defaults to `latest` (newest master build).
# Pin a release for reproducible deploys and easy rollback, e.g.:
#   DOSSIER_TAG=v1.2.0      (a tagged release)
#   DOSSIER_TAG=sha-abc1234 (an exact commit)
# Ignored for local dev: docker-compose.override.yml rebuilds images from source.
DOSSIER_TAG=latest

# Optional: override DATABASE_URL if not using default
# DATABASE_URL=postgresql://dossier:password@localhost:5432/dossier
#
# Host-side tools (e.g. scripts/seed_mock_db.py): use localhost and the published
# port (5432 with docker-compose.override.yml). Match POSTGRES_DB / user / password
# to the db service. If DATABASE_URL uses @db: (Compose hostname), the seed script
# rewrites the host to localhost unless DOSSIER_SKIP_DB_HOST_REMAP=1.

# ---------------------------------------------------------------------------
# LLM inference backend — rewriting
# ---------------------------------------------------------------------------
# Two backends are supported: "ollama" (local dev) and "vllm" (Modal GPU, prod).
# When LLM_PROVIDER is unset or empty, the value in config/app.yaml is used
# (default: ollama).
#
# --- Local dev (default, no Modal account needed) ---
# Leave LLM_PROVIDER unset; run `docker compose up` with COMPOSE_PROFILES=local-llm
# (see below) to start Ollama automatically.
#
# --- NAS production (Modal GPU backend) ---
# Deploy modal/rewrite_server.py first (see docs/MODAL_GPU_BACKEND.md), then:
# LLM_PROVIDER=vllm
# LLM_API_BASE=https://<workspace>--dossier-rewrite-serve.modal.run/v1
# OPENAI_API_KEY=<bearer-token-from-modal-secret>

# ---------------------------------------------------------------------------
# LLM inference backend — embeddings (article clustering)
# ---------------------------------------------------------------------------
# Same pattern as above. "vllm" points to modal/embed_server.py (BGE-M3, L4 GPU).
#
# --- NAS production ---
# EMBED_PROVIDER=vllm
# EMBED_API_BASE=https://<workspace>--dossier-embed-serve.modal.run/v1
# EMBED_API_KEY=<bearer-token-from-modal-secret>

# ---------------------------------------------------------------------------
# Ollama — local dev only
# ---------------------------------------------------------------------------
# Ignored when LLM_PROVIDER=vllm / EMBED_PROVIDER=vllm.
# COMPOSE_PROFILES=local-llm starts an Ollama container and pulls models on first run.
# Remove or comment out COMPOSE_PROFILES to disable the bundled Ollama service.
COMPOSE_PROFILES=local-llm
OLLAMA_HOST=http://ollama:11434
#
# Ollama on the host instead (not in Compose): comment out COMPOSE_PROFILES and set:
# OLLAMA_HOST=http://host.docker.internal:11434

# Optional: raise Postgres pool size for many parallel rewrite threads (default 32).
# DOSSIER_DB_POOL_MAX=32
