# Optional for development: docker-compose up works without this file.
# Copy to .env to override defaults or for production.

# Database (dev defaults used when .env is absent)
POSTGRES_PASSWORD=devpassword
POSTGRES_USER=dossier
POSTGRES_DB=dossier

# Flask (dev default used when .env is absent)
SECRET_KEY=dev-secret-key-change-in-production

# Optional: override DATABASE_URL if not using default
# DATABASE_URL=postgresql://dossier:password@localhost:5432/dossier
#
# Host-side tools (e.g. scripts/seed_mock_db.py): use localhost and the published
# port (5432 with docker-compose.override.yml). Match POSTGRES_DB / user / password
# to the db service. If DATABASE_URL uses @db: (Compose hostname), the seed script
# rewrites the host to localhost unless DOSSIER_SKIP_DB_HOST_REMAP=1.

# Ollama — clustering/embeddings/rewrite need a running Ollama reachable from the worker.
#
# Parallel rewrite jobs: docker-compose sets OLLAMA_NUM_PARALLEL=4 on the ollama service.
# Override on the host if needed (see Ollama docs).
#
# Default: run Ollama in Compose and pull models automatically on first `docker compose up`
# (ollama-init runs qwen2.5:7b, qwen2.5:3b, bge-m3). The worker waits for pulls
# to finish before starting. Models live in the ollama_data volume, not in the app image.
COMPOSE_PROFILES=local-llm
OLLAMA_HOST=http://ollama:11434
#
# Ollama on the host instead (not in Compose): remove or comment out COMPOSE_PROFILES above
# so the bundled ollama service is not started, then point the worker at the host, e.g.:
# OLLAMA_HOST=http://host.docker.internal:11434

# Optional: raise Postgres pool size for many parallel rewrite threads (default 32).
# DOSSIER_DB_POOL_MAX=32

# PWA Push Notifications (generate with: python3 -c "from pywebpush import Vapid; v = Vapid(); v.generate_keys(); print('VAPID_PRIVATE_KEY=' + v.private_key.decode()); print('VAPID_PUBLIC_KEY=' + v.public_key.decode())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com
