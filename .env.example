# Optional for development: docker-compose up works without this file.
# Copy to .env to override defaults or for production.

# Database (dev defaults used when .env is absent)
POSTGRES_PASSWORD=devpassword
POSTGRES_USER=dossier
POSTGRES_DB=dossier

# Flask (dev default used when .env is absent)
SECRET_KEY=dev-secret-key-change-in-production

# Optional: override DATABASE_URL if not using default
# DATABASE_URL=postgresql://dossier:password@localhost:5432/dossier

# Ollama (optional override; default in Docker is http://ollama:11434)
# OLLAMA_HOST=http://ollama:11434

# Scheduler split for Pi + PC hybrid deployment (see docs/DEPLOYMENT_HYBRID.md).
# Omit or set to full for normal Docker / single-machine runs.
#
#   light — fetch feeds, enrich articles, source availability (e.g. Raspberry Pi)
#   heavy — cluster + embed + rewrite (requires Ollama; e.g. desktop PC)
#   full  — all jobs (default)
#
# SCHEDULER_MODE=full
